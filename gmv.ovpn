SERVER_PUBLIC_IP="85.52.191.57"
CLIENT="gmv"

cat > ~/ovpn-export/${CLIENT}.ovpn <<EOF
client
dev tun
proto udp
remote ${SERVER_PUBLIC_IP} 1194
resolv-retry infinite
nobind
persist-key
persist-tun

remote-cert-tls server
auth SHA256
cipher AES-256-GCM
verb 3
key-direction 1

<ca>
$(sudo cat /etc/openvpn/server/ca.crt)
</ca>
<cert>
$(sudo cat /etc/openvpn/server/easy-rsa/pki/issued/${CLIENT}.crt)
</cert>
<key>
$(sudo cat /etc/openvpn/server/easy-rsa/pki/private/${CLIENT}.key)
</key>
<tls-crypt>
$(sudo cat /etc/openvpn/server/ta.key)
</tls-crypt>
EOF